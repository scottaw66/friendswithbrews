{
  "name": "friendswithbrews",
  "version": "0.10.0",
  "description": "Friends with Brews web site",
  "scripts": {
    "dev": "export NODE_ENV=development && astro dev",
    "dev:h": "export NODE_ENV=development && astro dev --host",
    "start": "npm run dev",
    "start:h": "npm run dev:h",
    "build": "export NODE_ENV=production && astro build && npx -y pagefind@latest",
    "build:p": "npm run build && npm run preview",
    "build:ph": "npm run build && npm run preview:h",
    "preview": "astro preview",
    "preview:h": "astro preview --host"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beeping-Machine/friendswithbrews.git"
  },
  "keywords": [
    "astro",
    "podcast",
    "friendswithbrews",
    "beer",
    "coffee",
    "tea",
    "friends",
    "peter",
    "scott"
  ],
  "author": "Scott willsey",
  "dependencies": {
    "@astrojs/image": "^0.14.0",
    "@astrojs/rss": "^2.1.0",
    "@astrojs/sitemap": "^1.0.1",
    "@fontsource/be-vietnam-pro": "^4.5.8",
    "@fontsource/roboto-mono": "^4.5.10",
    "astro": "^2.0.6",
    "astro-embed": "^0.2.1",
    "astro-icon": "^0.8.0",
    "astro-remark-eleventy-image": "^1.1.0",
    "astro-seo": "^0.7.0",
    "config": "^3.3.9",
    "date-fns": "^2.29.3",
    "date-fns-tz": "^2.0.0",
    "nanoid": "^4.0.1",
    "normalize.css": "^8.0.1",
    "remark-gfm": "^3.0.1",
    "sanitize-html": "^2.9.0",
    "sharp": "^0.31.3"
  },
  "devDependencies": {
    "astro-eslint-parser": "^0.11.0",
    "eslint": "^8.33.0",
    "eslint-plugin-astro": "^0.23.0",
    "prettier": "^2.8.3",
    "prettier-plugin-astro": "^0.8.0"
  }
}
