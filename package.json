{
  "name": "friendswithbrews",
  "version": "3.0.1",
  "description": "Friends with Brews web site",
  "scripts": {
    "dev": "export NODE_ENV=development && astro dev",
    "start": "npm run dev",
    "build": "export NODE_ENV=production && astro build && /Users/scott/Scripts/Sites/fwb/deploy.sh",
    "buildonly": "export NODE_ENV=production && astro build",
    "buildo": "export NODE_ENV=production && astro build",
    "build:p": "npm run buildo && npm run preview",
    "preview": "astro preview",
    "check:overrides": "node scripts/check-overrides.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottaw66/friendswithbrews.git"
  },
  "keywords": [
    "astro",
    "podcast",
    "friendswithbrews",
    "beer",
    "coffee",
    "tea",
    "friends",
    "peter",
    "scott"
  ],
  "author": "Scott Willsey",
  "dependencies": {
