{
  "name": "friendswithbrews",
  "version": "3.0.0",
  "description": "Friends with Brews web site",
  "scripts": {
    "dev": "export NODE_ENV=development && astro dev",
    "dev:h": "export NODE_ENV=development && astro dev --host",
    "start": "npm run dev",
    "start:h": "npm run dev:h",
    "build": "export NODE_ENV=production && astro build",
    "build:p": "npm run build && npm run preview",
    "build:ph": "npm run build && npm run preview:h",
    "preview": "astro preview",
    "preview:h": "astro preview --host"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottaw66/friendswithbrews.git"
  },
  "keywords": [
    "astro",
    "podcast",
    "friendswithbrews",
    "beer",
    "coffee",
    "tea",
    "friends",
    "peter",
    "scott"
  ],
  "author": "Scott Willsey",
  "dependencies": {
    "@11ty/eleventy-img": "^3.1.0",
    "@astrojs/rss": "^3.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@fontsource/be-vietnam-pro": "^5.0.12",
    "@fontsource/ia-writer-mono": "^5.0.7",
    "@fontsource/roboto-mono": "^5.0.8",
    "astro": "^3.0.12",
    "astro-embed": "^0.5.1",
    "astro-icon": "^0.8.1",
    "astro-pagefind": "^1.2.3",
    "astro-seo": "^0.8.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "nanoid": "^4.0.2",
    "normalize.css": "^8.0.1",
    "sanitize-html": "^2.11.0"
  },
  "devDependencies": {
    "astro-eslint-parser": "^0.15.0",
    "eslint": "^8.49.0",
    "eslint-plugin-astro": "^0.29.0",
    "prettier": "^3.0.3",
    "prettier-plugin-astro": "^0.12.0"
  }
}
