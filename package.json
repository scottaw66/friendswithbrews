{
  "name": "friendswithbrews",
  "version": "3.0.1",
  "description": "Friends with Brews web site",
  "scripts": {
    "dev": "export NODE_ENV=development && astro dev",
    "dev:h": "export NODE_ENV=development && astro dev --host",
    "start": "npm run dev",
    "start:h": "npm run dev:h",
    "build": "export NODE_ENV=production && astro build",
    "build:p": "npm run build && npm run preview",
    "build:ph": "npm run build && npm run preview:h",
    "preview": "astro preview",
    "preview:h": "astro preview --host"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottaw66/friendswithbrews.git"
  },
  "keywords": [
    "astro",
    "podcast",
    "friendswithbrews",
    "beer",
    "coffee",
    "tea",
    "friends",
    "peter",
    "scott"
  ],
  "author": "Scott Willsey",
  "dependencies": {
    "@astrojs/rss": "^4.0.6",
    "@astrojs/sitemap": "^3.1.5",
    "@fontsource/be-vietnam-pro": "^5.0.20",
    "@fontsource/ia-writer-mono": "^5.0.11",
    "@fontsource/roboto-mono": "^5.0.18",
    "@iconify-json/bi": "^1.1.23",
    "@iconify-json/dashicons": "^1.1.9",
    "@iconify-json/fa": "^1.1.8",
    "@iconify-json/fa-solid": "^1.1.8",
    "@iconify-json/fluent": "^1.1.56",
    "@iconify-json/fontisto": "^1.1.8",
    "@iconify-json/ic": "^1.1.17",
    "@iconify-json/ion": "^1.1.18",
    "@iconify-json/mdi": "^1.1.66",
    "@iconify-json/ps": "^1.1.9",
    "@iconify-json/simple-icons": "^1.1.104",
    "astro": "^4.10.1",
    "astro-embed": "^0.7.2",
    "astro-icon": "^1.1.0",
    "astro-pagefind": "^1.5.0",
    "astro-seo": "^0.8.4",
    "date-fns": "^3.6.0",
    "nanoid": "^5.0.7",
    "normalize.css": "^8.0.1",
    "sanitize-html": "^2.13.0",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "eslint": "^9.4.0",
    "eslint-plugin-astro": "^1.2.0",
    "prettier": "^3.3.1",
    "prettier-plugin-astro": "^0.14.0"
  }
}
