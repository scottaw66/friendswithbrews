    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/dashicons": "^1.2.1",
    "@iconify-json/fa": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@iconify-json/fluent": "^1.2.52",
