{
  "name": "friendswithbrews",
  "version": "1.0.2",
  "description": "Friends with Brews web site",
  "scripts": {
    "dev": "export NODE_ENV=development && astro dev",
    "dev:h": "export NODE_ENV=development && astro dev --host",
    "start": "npm run dev",
    "start:h": "npm run dev:h",
    "build": "export NODE_ENV=production && astro build",
    "build:p": "npm run build && npm run preview",
    "build:ph": "npm run build && npm run preview:h",
    "preview": "astro preview",
    "preview:h": "astro preview --host"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottaw66/friendswithbrews.git"
  },
  "keywords": [
    "astro",
    "podcast",
    "friendswithbrews",
    "beer",
    "coffee",
    "tea",
    "friends",
    "peter",
    "scott"
  ],
  "author": "Scott willsey",
  "dependencies": {
    "@astrojs/image": "^0.17.1",
    "@astrojs/rss": "^2.4.3",
    "@astrojs/sitemap": "^1.3.3",
    "@fontsource/be-vietnam-pro": "^5.0.3",
    "@fontsource/ia-writer-mono": "^5.0.3",
    "@fontsource/roboto-mono": "^5.0.3",
    "astro": "^2.7.1",
    "astro-embed": "^0.2.1",
    "astro-icon": "^0.8.1",
    "astro-pagefind": "^1.2.1",
    "astro-remark-eleventy-image": "^2.0.1",
    "astro-seo": "^0.7.4",
    "config": "^3.3.9",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "nanoid": "^4.0.2",
    "normalize.css": "^8.0.1",
    "remark-gfm": "^3.0.1",
    "sanitize-html": "^2.11.0"
  },
  "devDependencies": {
    "astro-eslint-parser": "^0.14.0",
    "eslint": "^8.43.0",
    "eslint-plugin-astro": "^0.27.2",
    "prettier": "^2.8.8",
    "prettier-plugin-astro": "^0.10.0"
  }
}
