---
import config from "config";
import { Icon } from "astro-icon";
import { year } from "./utilities/DateFormat.js";
import Search from "../components/Search.astro";
---

<Search />
<div class="footer" data-pagefind-ignore>
  <div>
    <a rel="me" href="https://appdot.net/@friendswbrews"
      ><Icon name="simple-icons:mastodon" />
    </a>
  </div>
  <div>&copy;{year}</div>
  <div><Icon name="bi:cpu-fill" /></div>
  <div>
    {config.get("name")}
  </div>
  <div><Icon name="ps:rss" /></div>
  <div><a href="/subscribe">Subscribe</a></div>
</div>

<style>
  .footer {
    width: 100%;
    height: 25px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin: 0 auto;
    padding: 0.5rem 0;
    border-top: 3px solid var(--menu-border);
    font-size: 1rem;
    background-color: var(--menu-surface);
    color: var(--menu-text);
  }
  .footer a {
    color: var(--menu-text);
  }
  [astro-icon] {
    height: 1rem;
    margin: 0 0 -0.1rem;
    padding: 0;
  }
  @media screen and (max-width: 450px) {
    .footer {
      font-size: 0.8rem;
    }
    [astro-icon] {
      margin: 0 0 -0.2rem;
    }
  }
</style>
