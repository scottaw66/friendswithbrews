---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";

const instance = "fwb";
---

<PagefindConfig instance={instance} />

<div class="search-component pagefind-ui">
  <pagefind-input
    instance={instance}
    placeholder="Search for anything…"></pagefind-input>

  <div class="search-layout">
    <pagefind-filter-pane instance={instance} expanded show-empty
    ></pagefind-filter-pane>
    <div class="search-results-col">
      <pagefind-summary instance={instance}></pagefind-summary>
      <pagefind-results instance={instance} show-sub-results></pagefind-results>
    </div>
  </div>
</div>
