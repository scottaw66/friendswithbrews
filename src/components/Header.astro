---
import config from "config";
import logo from "../images/FwBrews-site-header.svg";
---

<div class="header">
  <div><a href="/"><img class="header-image" src={logo.src} /></a></div>
  <div class="site-title"><a href="/">Friends with Brews !</a></div>
  <div class="site-tagline">
    <p class="tagline">{config.get("description")}</p>
  </div>
</div>
<div class="nav-container">
  <nav>
    <div class="menu1"><a href="/">Home</a></div>
    <div class="menu2"><a href="/friends">The Friends</a></div>
    <div class="menu3"></div>
    <div class="menu4"><a href="/brews/1">The Brews</a></div>
    <div class="menu5"><a href="/episodes/1">Episodes</a></div>
  </nav>
</div>

<style>
  div.header {
    width: 100%;
    background-color: var(--header-surface);
    padding: 0 2rem;
    display: flex;
    gap: 2rem;
    align-items: center;
    color: var(--header-text);
  }
  div.site-title {
    font-family: "CaptainEdward";
    font-weight: 900;
    font-size: 4rem;
  }
  div.site-title a {
    text-decoration: none;
    color: var(--header-text);
  }
  div.site-tagline {
    max-width: 350px;
    text-transform: uppercase;
    margin-top: 0.45rem;
  }
  .header-image {
    height: 10rem;
    margin: 1rem -1rem 0 0;
  }
  div.nav-container {
    width: 100%;
    background-color: var(--menu-surface);
    border-bottom: solid 5px var(--menu-border);
  }
  nav {
    display: grid;
    grid-template-columns: max-content max-content 200px max-content max-content;
    column-gap: 2rem;
    width: fit-content;
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem 0;
    justify-items: center;
    align-items: center;
    font-family: "CaptainEdward";
    position: relative;
  }

  nav a {
    text-decoration: none;
    color: var(--menu-text);
  }
  nav a:hover {
    text-decoration: none;
  }
  @media screen and (max-width: 680px) {
    nav {
      column-gap: 1rem;
    }
  }
  @media screen and (max-width: 600px) {
    nav {
      grid-template-rows: 1fr 1fr;
      grid-auto-flow: row;
    }
    .menu1 {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
    }
    .menu2 {
      grid-column: 1;
      grid-row: 2;
      justify-self: start;
    }
    .menu4 {
      grid-column: 5;
      grid-row: 1;
      justify-self: end;
    }
    .menu5 {
      grid-column: 5;
      grid-row: 2;
      justify-self: end;
    }
  }
  @media screen and (max-width: 500px) {
    nav {
      grid-template-columns: max-content 120px max-content max-content;
      padding: 0.5rem 0.1rem;
      font-size: 0.9rem;
    }
    .header-image {
      height: 8rem;
      left: calc(50% - 64px);
    }
  }
  @media screen and (max-width: 380px) {
    div.nav-container {
      margin-bottom: 5em;
    }
    nav {
      font-size: 0.8rem;
      grid-template-columns: max-content 100px max-content max-content;
      padding: 0;
    }
    .header-image {
      height: 6rem;
      left: calc(50% - 48px);
    }
  }
  @media screen and (max-width: 342px) {
    nav {
      font-size: 0.75rem;
    }
  }
</style>
