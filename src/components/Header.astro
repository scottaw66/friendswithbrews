---
import config from "config";
import logo from "../images/FwBrews-site-header.svg";
---

<div class="header">
  <div class="banner" role="banner">
    <div><a href="/"><img class="header-image" src={logo.src} /></a></div>
    <div class="site-title"><a href="/">Friends with Brews</a></div>
    <div class="site-tagline">{config.get("description")}</div>
  </div>
  <div class="nav-container">
    <nav role="navigation">
      <ul>
        <li><a href="/friends">The Friends</a></li>
        <li><a href="/brews/1">The Brews</a></li>
        <li><a href="/episodes/1">Episodes</a></li>
        <li><a href="/transcripts/1">Transcripts</a></li>
        <li><a href="/follow">Follow</a></li>
      </ul>
    </nav>
  </div>
</div>

<style>
  div.header {
    width: 100%;
    background-color: var(--header-surface);
  }
  div.banner {
    width: 100%;
    display: flex;
    gap: 2rem;
    align-items: center;
    color: var(--header-text);
  }
  div.site-title {
    font-family: "CaptainEdward";
    font-weight: 900;
    font-size: clamp(0.7rem, 2vw + 1rem, 4rem);
  }
  div.site-title a {
    text-decoration: none;
    color: var(--header-text);
  }
  div.site-tagline {
    max-width: 350px;
    text-transform: uppercase;
    margin-right: 2rem;
    margin-top: 0.5rem;
  }
  .header-image {
    height: 10rem;
    margin: 1rem -1rem 0 2rem;
  }
  @media screen and (min-width: 2000px) {
    .header-image {
      margin-left: 5rem;
    }
  }
  @media screen and (max-width: 850px) {
    div.header {
      gap: 1rem;
    }
    div.site-tagline {
      font-size: 0.7rem;
    }
    .header-image {
      height: 8rem;
      margin: 1rem -0.75rem 0 1rem;
    }
  }
  div.nav-container {
    width: 100%;
    background-color: var(--menu-surface);
    border-bottom: solid 5px var(--menu-border);
    margin-bottom: 3em;
  }
  @media screen and (max-width: 680px) {
    div.site-tagline {
      max-width: 300px;
      margin-right: 1rem;
    }
    .header-image {
      margin: 0.5rem 0 0 0.5rem;
    }
  }
  @media screen and (max-width: 380px) {
    div.nav-container {
      margin-bottom: 1em;
    }
    .header-image {
      height: 6rem;
    }
  }
  nav {
    margin: 0 auto;
    font-family: "CaptainEdward";
    font-size: 1.5rem;
  }
  nav ul {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    justify-items: center;
    list-style: none;
    padding: 0;
  }
  nav ul li a {
    display: block;
    text-decoration: none;
    padding: 1rem;
  }
  nav ul li a:hover {
    text-decoration: none;
    background-color: var(--menu-border);
    color: var(--header-surface);
  }
  @media screen and (max-width: 850px) {
    nav {
      font-size: 1rem;
    }
  }
</style>
