---
import logo from "../images/FwBrews-site-header.svg";
---

<div class="nav-container">
  <nav>
    <div><a href="/">Home</a></div>
    <div><a href="/friends">The Friends</a></div>
    <div><img class="header-image" src={logo} /></div>
    <div><a href="/brews/1">The Brews</a></div>
    <div><a href="/episodes/1">Episodes</a></div>
  </nav>
</div>

<style>
  div.nav-container {
    width: 100%;
    background-color: var(--menu-surface);
    border-bottom: solid 5px var(--menu-border);
    margin-bottom: 8em;
  }
  nav {
    display: grid;
    grid-template-columns: max-content max-content 200px max-content max-content;
    column-gap: 2rem;
    width: fit-content;
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem 0;
    justify-items: center;
    align-items: center;
    font-family: "CaptainEdward";
    position: relative;
  }

  .header-image {
    height: 10rem;
    position: absolute;
    left: calc(50% - 80px);
    top: 0.25rem;
  }

  nav a {
    text-decoration: none;
    color: var(--menu-text);
  }
  nav a:hover {
    text-decoration: none;
  }

  @media screen and (max-width: 680px) {
    nav {
      font-size: 0.9rem;
    }
  }
  @media screen and (max-width: 376px) {
    nav {
      font-size: 0.8rem;
      width: 100%;
    }
  }
  @media screen and (max-width: 342px) {
    nav {
      font-size: 0.75rem;
      width: 100%;
    }
  }
  @media screen and (max-width: 321px) {
    nav {
      font-size: 0.75rem;
      width: 100%;
    }
  }
</style>
