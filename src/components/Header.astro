---
import config from "config";
import logo from "../images/FwBrews-site-header.svg";
---

<div class="header">
  <div class="banner" role="banner">
    <div class="site-title">
      <div class="title1"><a href="/">Friends</a></div><div class="title2">
        <a href="/">With Brews</a>
      </div>
    </div>
    <div class="site-image">
      <a href="/"><img class="header-image" src={logo.src} /></a>
    </div>
    <div class="site-tagline">{config.get("description")}</div>
  </div>
  <div class="nav-container">
    <nav role="navigation">
      <ul>
        <li><a href="/friends">The Friends</a></li>
        <li><a href="/brews/1">The Brews</a></li>
        <li><a href="/episodes/1">Episodes</a></li>
        <li><a href="/transcripts/1">Transcripts</a></li>
        <li><a href="/follow">Follow</a></li>
      </ul>
    </nav>
  </div>
</div>

<style>
  div.header {
    width: 100%;
    background-color: var(--header-surface);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  div.banner {
    width: 100%;
    margin: 0 auto 1rem;
    display: flex;
    gap: 4rem;
    align-items: center;
    justify-content: center;
    color: var(--header-text);
  }
  div.site-title {
    display: flex;
    width: fit-content;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin: 2rem 0 1rem 2rem;
    font-family: "CaptainEdward";
    font-weight: 900;
    line-height: clamp(1rem, 1vw + 2.2rem, 6rem);
  }
  div.title1 {
    font-size: clamp(1.5rem, calc(2vw + 2.5rem), 4.5rem);
  }
  div.title2 {
    font-size: clamp(1rem, calc(2vw + 1rem), 2.7rem);
  }
  div.site-title a {
    text-decoration: none;
    color: var(--header-text);
  }
  div.site-image {
  }
  .header-image {
    height: 10rem;
    margin: 1rem 0 2rem;
  }
  div.site-tagline {
    max-width: 350px;
    text-transform: uppercase;
    margin-top: 0.5rem;
  }
  div.nav-container {
    width: 100%;
    background-color: var(--menu-surface);
    border-bottom: solid 5px var(--menu-border);
    margin-bottom: 3em;
  }
  @media screen and (max-width: 850px) {
    div.banner {
      gap: 1.5rem;
    }
    div.site-tagline {
      font-size: 0.75rem;
    }
  }
  @media screen and (max-width: 795px) {
    div.banner {
      gap: 1rem;
    }
    .header-image {
      height: 6rem;
      margin: 0.75rem 0;
    }
  }
  @media screen and (max-width: 680px) {
    div.site-title {
      margin: 1rem 0;
    }
    div.site-tagline {
      max-width: 300px;
      margin-right: 1rem;
    }
    .header-image {
      margin: -0.2rem 0 0;
    }
  }
  @media screen and (max-width: 500px) {
    div.banner {
      margin: 0;
    }
    div.site-tagline {
      display: none;
    }
    .header-image {
      height: 4.5rem;
    }
  }
  nav {
    margin: 0 auto;
    font-family: "CaptainEdward";
    font-size: 1.5rem;
  }
  nav ul {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    justify-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav ul li a {
    display: block;
    text-decoration: none;
    padding: 1rem;
  }
  nav ul li a:hover {
    text-decoration: none;
    background-color: var(--menu-border);
    color: var(--header-surface);
  }
  @media screen and (max-width: 850px) {
    nav {
      font-size: 1rem;
    }
  }
</style>
