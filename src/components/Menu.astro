---
import { Icon } from "astro-icon/components";
---

<div class="nav-container">
  <nav id="main-nav" role="navigation">
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/friends">The Friends</a></li>
      <li><a href="/brews/1">The Brews</a></li>
      <li><a href="/episodes/1">Episodes</a></li>
      <li><a href="/transcripts/page/1">Transcripts</a></li>
      <li><a href="/follow">Follow</a></li>
      <li><a href="/search/"><Icon name="fluent:search-12-filled" /></a></li>
    </ul>
  </nav>
</div>

<style>
  div.nav-container {
    width: 100%;
    margin: 0 auto;
    background-color: var(--menu-surface);
    border-bottom: solid 5px var(--menu-border);
    grid-area: menu;
  }
  nav {
    margin: 0 auto;
    font-family: "CaptainEdward";
    font-size: 1.5rem;
  }
  nav ul {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    justify-items: center;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1rem;
  }
  nav ul li a {
    display: block;
    text-decoration: none;
    padding: 1rem;
  }
  nav ul li a:hover {
    text-decoration: none;
    background-color: var(--menu-border);
    color: var(--header-surface);
  }
  nav ul li:first-child {
    padding-left: 2rem;
  }
  nav ul li:last-child {
    padding-right: 2rem;
  }
  @media only screen and (max-width: 899px) {
    div.nav-container {
      border-bottom: none;
    }
    nav ul {
      width: fit-content;
      grid-template-columns: none;
      grid-template-rows: repeat(7, 1fr);
      justify-items: start;
      padding: 0 2rem 3rem;
      gap: 0.5rem;
      margin: 0 6rem;
    }
    nav ul li:first-child {
      padding-left: 0;
    }
    nav ul li a {
      padding: 0;
    }
  }
  @media only screen and (max-width: 599px) {
    nav ul {
      margin: 0;
    }
  }

  [data-icon] {
    font-size: 1.5em;
    margin-bottom: -0.2rem;
  }
</style>
