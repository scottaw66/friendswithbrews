---
import { randomReviews } from "./utilities/randomreviews.mjs";
---

<div class="reviews" data-pagefind-ignore>
  {
    randomReviews(3).map((review) => (
      <blockquote>
        <q class="review">{review.review}</q> -{" "}
        <span class="reviewer">{review.reviewer}</span>
      </blockquote>
    ))
  }
</div>
<style>
  div.reviews {
    display: flex;
    flex-direction: column;
    width: 90%;
    margin: 0 auto;
    justify-content: center;
  }
  blockquote {
    font-style: italic;
    padding: 1rem 2rem;
    border-radius: 10px;
    border: 1px solid var(--menu-border);
  }
  span.reviewer {
    font-weight: bold;
    font-style: normal;
    font-size: 0.8em;
  }
  @media screen and (max-width: 580px) {
    blockquote {
      width: 80%;
      margin: 1rem 0;
    }
  }
</style>
