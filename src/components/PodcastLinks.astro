---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon";
import site from "../data/site.json"

interface Props {
  episode: CollectionEntry<"episodes">;
  transcript?: string[];
}

const { episode, transcript } = Astro.props;
---

<div class="episode-links">
  <div class="download-link">
    <div>
      <a href={`${site.episodes.audioPrefix}${episode.data.audioFile}`}>
        <Icon name="mdi:cloud-download" />
      </a>
    </div>
    <div>
      <a href={`${site.episodes.audioPrefix}${episode.data.audioFile}`}
        >Download</a
      >
    </div>
  </div>
  {
    transcript?.length > 0 && (
      <div class="download-link">
        <div>
          <a href={`/transcripts/${transcript}`}>
            <Icon name="ic:baseline-document-scanner" />
          </a>
        </div>
        <div>
          <a href={`/transcripts/${transcript}`}>Transcript</a>
        </div>
      </div>
    )
  }
  <div class="download-link">
    <div>
      <a href={site.social.overcast}>
        <Icon name="simple-icons:overcast" />
      </a>
    </div>
    <div><a href={site.social.overcast}>Overcast</a></div>
  </div>
  <div class="download-link">
    <div>
      <a href={site.social.applePodcasts}>
        <Icon name="simple-icons:applepodcasts" />
      </a>
    </div>
    <div>
      <a href={site.social.applePodcasts}>Apple Podcasts</a>
    </div>
  </div>
</div>

<style>
  div.episode-links {
    display: flex;
    margin: 0 auto;
    justify-content: center;
  }
  div.download-link {
    display: flex;
    padding: 0 1rem;
    font-size: 0.6em;
    text-transform: uppercase;
    font-weight: bold;
    align-items: center;
  }
  div.download-link a {
    color: var(--text);
    text-decoration: underline;
  }
  @media screen and (max-width: 500px) {
    div.episode-links {
      flex-direction: column;
      row-gap: 0.3rem;
    }
  }
  [astro-icon="mdi:cloud-download"],
  [astro-icon="ic:baseline-document-scanner"],
  [astro-icon="simple-icons:overcast"],
  [astro-icon="simple-icons:applepodcasts"] {
    height: 1.5rem;
    margin: 0.1rem 0.5rem 0 0;
  }
</style>
