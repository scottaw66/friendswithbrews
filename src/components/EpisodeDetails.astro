---
import config from "config";
import { Icon } from "astro-icon";
import path from "path";
import { brewList } from "../components/utilities/brewlist.mjs";
import BeerDetails from "./BeerDetails.astro";
import Player from "./Player.astro";
import { postdate } from "./utilities/DateFormat";
import { episodeLength } from "./utilities/episodelength.mjs";

const { episode } = Astro.props;
const beers = brewList(episode.frontmatter.slug);
---

<div class="elv">
  <h3>
    <Icon name="fontisto:podcast" />Episode {episode.frontmatter.episode} •
    <span class="episode-number"
      ><a
        href={new URL(
          path.join(
            config.get("episodes.path"),
            String(episode.frontmatter.slug)
          ),
          config.get("url")
        )}
        >{episode.frontmatter.title}
      </a>
    </span>
  </h3>
  <div class="episode-date">
    <span
      ><Icon name="fluent:calendar-rtl-48-filled" />{
        postdate(episode.frontmatter.date)
      }</span
    > •
    <span>{episodeLength(episode.frontmatter.length)}</span>
  </div>
  <p>{episode.frontmatter.description}</p>
  <Player
    file={`${config.get("episodes.audioPrefix")}${
      episode.frontmatter.audioFile
    }`}
    episode={episode.frontmatter.episode}
    title={episode.frontmatter.title}
  />
  <div class="beer-container">
    {
      beers.map((beer) => (
        <BeerDetails beer={beer} episode={episode.frontmatter.slug} />
      ))
    }
  </div>
</div>

<style>
  div.elv {
    margin: 2rem auto;
    padding: 0.2rem 2rem;
    border-radius: 10px;
    border: 1px solid var(--menu-border);
    max-width: 90%;
  }
  h3 {
    font-weight: 500;
    font-size: 1.5rem;
  }
  [astro-icon="fontisto:podcast"] {
    height: 1.5rem;
    margin: 0 0.5rem -0.1em 0;
  }
  span.episode-number {
    color: var(--menu-surface);
  }
  div.episode-date {
    display: flex;
    align-items: center;
    font-size: 0.6em;
    column-gap: 0.5rem;
  }
  [astro-icon="fluent:calendar-rtl-48-filled"] {
    height: 1rem;
    margin: 0 0.25rem -0.25em 0.25rem;
  }
  a {
    color: var(--menu-surface);
    text-decoration: none;
  }
</style>
