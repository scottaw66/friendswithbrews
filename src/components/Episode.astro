---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import config from "config";
import { Icon } from "astro-icon";
import path from "path";
import { brewList } from "../components/utilities/brewlist.mjs";
import BrewDetails from "./BrewDetails.astro";
import Player from "./Player.astro";
import PodcastLinks from "./PodcastLinks.astro";
import { postdate } from "./utilities/DateFormat";
import { episodeLength } from "./utilities/episodelength.mjs";

interface Props {
  episode: CollectionEntry<"episodes">;
  audio;
  index;
  pageNum;
}
const { episode, audio, index, pageNum } = Astro.props;
const { Content } = await episode.render();
const brews = brewList(episode.data.episode);
const transcript = await getCollection("transcripts", ({ id }) => {
  return id.endsWith(`${episode.data.episode}.md`);
});
---

<div
  class="episode"
  data-pagefind-filter="filter by[content]"
  content="episode"
  data-pagefind-meta="result type:episode"
>
  <h2 class="episode-title">
    <Icon name="fontisto:podcast" />Episode <span data-pagefind-meta="episode"
      >{episode.data.episode}</span
    > •
    <span class="episode-number"
      ><a
        href={new URL(
          path.join(config.get("episodes.path"), String(episode.data.episode)),
          config.get("url")
        )}
        >{episode.data.title}
      </a>
    </span>
  </h2>
  <div class="episode-date">
    <span data-pagefind-meta="date"
      ><Icon name="fluent:calendar-rtl-48-filled" />{
        postdate(episode.data.date)
      }</span
    > •
    <span>{episodeLength(episode.data.length)}</span>
    {
      transcript.map((transcript) => (
        <span>
          •{" "}
          <>
            <Icon name="ic:baseline-document-scanner" />
            <a href={`/transcripts/${transcript.slug}`}>Transcript</a>
          </>
        </span>
      ))
    }
  </div>
  <p>{episode.data.description}</p>

  {
    () => {
      if ((index === 0 && pageNum === 1) || audio === "true") {
        return (
          <Player
            file={`${config.get("episodes.audioPrefix")}${
              episode.data.audioFile
            }`}
            episode={episode.data.episode}
            title={episode.data.title}
          />
        );
      }
    }
  }

  <PodcastLinks
    episode={episode}
    transcript={transcript.map((transcript) => transcript.slug.toString())}
  />

  <h2>The brew</h2>
  <div class="brew-container">
    {
      brews.map((brew) => (
        <BrewDetails brew={brew} episode={episode.data.episode} />
      ))
    }
  </div>
  <Content />
</div>

<style>
  div.episode {
    margin-bottom: 5rem;
  }
  [astro-icon="fontisto:podcast"] {
    height: 2.7rem;
    margin: 0 0.5rem -0.1em 0;
  }
  span.episode-number {
    color: var(--menu-surface);
  }
  h2.episode-title {
    font-size: 2.7rem;
  }
  div.episode-date {
    display: flex;
    align-items: center;
    font-size: 0.6em;
    column-gap: 0.5rem;
  }
  [astro-icon="fluent:calendar-rtl-48-filled"],
  [astro-icon="ic:baseline-document-scanner"] {
    height: 1rem;
    margin: 0 0.25rem -0.25em 0;
  }
  a {
    color: var(--menu-surface);
    text-decoration: none;
  }
  div.brew-container {
    border-radius: 10px;
    border: 1px solid var(--menu-border);
    padding: 0.5rem 1rem;
  }
</style>
