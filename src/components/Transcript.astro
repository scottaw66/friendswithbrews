---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { postdate } from "./utilities/DateFormat.mjs";
import site from "../data/site.json";
import { render } from "astro:content";

interface Props {
  transcript: CollectionEntry<"transcripts">;
}
const { transcript } = Astro.props;
const { Content } = await render(transcript);
---

<div
  class="transcript"
  data-pagefind-filter="filter by[content]"
  content="transcript"
  data-pagefind-meta="result type:transcript"
>
  <h2>
    <Icon name="ic:baseline-document-scanner" />
    <a href={`${site.episodes.path}${transcript.data.episode}`}
      >Episode {transcript.data.episode} – {transcript.data.title}</a
    >
  </h2>
  <div class="transcript-links">
    <span data-pagefind-meta="date"
      ><Icon name="fluent:calendar-rtl-48-filled" />{
        postdate(transcript.data.date)
      }</span
    > •
    <span
      ><Icon name="fontisto:podcast" /><a
        href={`${site.episodes.path}${transcript.data.episode}`}
        >Episode Audio</a
      ></span
    > • <span
      ><Icon name="ic:baseline-document-scanner" /><a href="/transcripts/page/1"
        >Transcripts Index</a
      ></span
    > • <span
      ><Icon name="fontisto:podcast" /><a href="/episodes/1">Episodes Index</a
      ></span
    >
  </div>
  <div class="subtitle">
    <Icon name="fluent:info-24-filled" />Description
  </div>
  <div class="description">{transcript.data.description}</div>
  <div class="subtitle">
    <Icon name="ic:baseline-document-scanner" />Transcript
  </div>
  <Content /><br />
  <div class="transcript-links">
    <Icon name="fontisto:podcast" /><a
      href={`${site.episodes.path}${transcript.data.episode}`}>Episode Audio</a
    > • <span
      ><Icon name="ic:baseline-document-scanner" /><a href="/transcripts/page/1"
        >Transcripts Index</a
      ></span
    > • <span
      ><Icon name="fontisto:podcast" /><a href="/episodes/1">Episodes Index</a
      ></span
    >
  </div>
</div>
<style>
  .transcript {
    font-family: "iA Writer Mono", monospace;
    font-size: 1.1rem;
    margin: 2rem 0;
  }
  .transcript-links {
    font-size: 0.8rem;
  }
  .transcript a {
    color: var(--link-text);
  }
  .transcript h2 a {
    text-decoration: none;
  }
  .transcript h2 a:hover {
    text-decoration: underline;
  }
  .subtitle {
    font-family: "Be Vietnam Pro";
    font-size: 1.3rem;
    font-weight: 800;
    margin: 2rem 0;
  }
  .description {
    font-family: "Be Vietnam Pro";
    font-size: 1.3rem;
  }
  [data-icon] {
    font-size: 1.3rem;
    margin: 0 0.5rem -0.2rem 0;
  }
  [data-icon="ic:baseline-document-scanner"] {
    font-size: 1em;
  }
  .transcript-links [data-icon] {
    font-size: 1em;
  }
</style>
