---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import site from "../data/site.json";

const title = "Subscribe to " + site.title;
---

<Base title={title}>
  <h1>Follow!</h1>
  <p>
    Please freely subscribe to our podcast so you never miss an episode! And by
    freely, I mean free, because it may cost you some time, but it won't cost
    you a dime!
  </p>
  <p>
    And <a rel="me" href={site.social.mastodon}>follow us on Mastodon</a>,
    because why not hang out online with strangers instead of talking to your
    family?
  </p>
  <p>
    <span class="podcast-name">{site.title}</span> is available directly using
    our RSS feed, or on the following platforms.
  </p>

  <div class="episode-links">
    <div class="download-link">
      <div>
        <a href={site.social.youtube}>
          <Icon name="simple-icons:youtube" />
        </a>
      </div>
      <div><a href={site.social.youtube}>YouTube</a></div>
    </div>
    <div class="download-link">
      <div>
        <a href={site.social.overcast}>
          <Icon name="simple-icons:overcast" />
        </a>
      </div>
      <div><a href={site.social.overcast}>Overcast</a></div>
    </div>
    <div class="download-link">
      <div>
        <a href={site.social.applePodcasts}>
          <Icon name="simple-icons:applepodcasts" />
        </a>
      </div>
      <div>
        <a href={site.social.applePodcasts}>Apple Podcasts</a>
      </div>
    </div>
    <div class="download-link">
      <div>
        <a href={`${site.rss.path}${site.rss.fileName}`}>
          <Icon name="ps:rss" />
        </a>
      </div>
      <div>
        <a href={`${site.rss.path}${site.rss.fileName}`}>RSS</a>
      </div>
    </div>
    <div class="download-link">
      <div>
        <a rel="me" href={site.social.mastodon}>
          <Icon name={site.social.mastodonIcon} />
        </a>
      </div>
      <div>
        <a rel="me" href={site.social.mastodon}>{site.social.mastodonName}</a>
      </div>
    </div>
  </div>
</Base>

<style>
  a {
    text-decoration: none;
    color: var(--link-text);
  }
  span.podcast-name {
    font-weight: bold;
  }
  div.episode-links {
    display: grid;
    gap: 1rem;
    margin: 3rem auto;
    justify-content: center;
  }
  div.download-link {
    display: flex;
    padding: 0 2rem;
    font-size: 1.5rem;
    text-transform: uppercase;
    font-weight: bold;
    align-items: center;
  }
  div.download-link a {
    color: var(--text);
    text-decoration: underline;
  }
  [data-icon] {
    font-size: 3rem;
    margin: 0.6rem 1rem 0 0;
  }
  @media screen and (max-width: 500px) {
    div.episode-links {
      margin: 2rem auto;
    }
    div.download-link {
      font-size: 1.2rem;
    }
    [data-icon] {
      font-size: 2rem;
      margin: 0.5rem 1rem 0;
    }
  }
  @media screen and (max-width: 400px) {
    div.download-link {
      font-size: 1rem;
    }
    [data-icon] {
      font-size: 1.5rem;
    }
  }
</style>
