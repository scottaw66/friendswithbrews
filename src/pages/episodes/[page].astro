---
import { getCollection } from "astro:content";
import config from "config";
import Base from "../../layouts/Base.astro";
import Episode from "../../components/Episode.astro";
import Pager from "../../components/Pager.astro";

export async function getStaticPaths({ paginate }) {
  let episodes = await getCollection("episodes");

  episodes = episodes.sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
  );

  return paginate(episodes, {
    pageSize: site.episodes.paginationSize,
  });
}
const { page } = Astro.props;
---

<Base title={`${site.title").replace(" Podcast", "} Episodes`}>
  <div data-pagefind-ignore>
    {
      page.data.map((episode, index) => {
        return (
          <Episode episode={episode} index={index} pageNum={page.currentPage} />
        );
      })
    }
    <Pager page={page} />
  </div>
</Base>
