---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import TranscriptListView from "../../../components/TranscriptListView.astro";
import Pager from "../../../components/Pager.astro";
import site from "../../../data/site.json";

export async function getStaticPaths({ paginate }) {
  let transcripts = await getCollection("transcripts");

  transcripts = transcripts.sort(
    (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
  );

  return paginate(transcripts, {
    pageSize: site.transcripts.paginationSize,
  });
}
const { page } = Astro.props;
---

<Base title={`${site.title.replace("Podcast", "")} Transcripts`}>
  <h1>Transcripts</h1>
  <div data-pagefind-ignore>
    {
      page.data.map((transcript, index) => {
        return <TranscriptListView transcript={transcript} />;
      })
    }
    <Pager page={page} />
  </div>
</Base>
