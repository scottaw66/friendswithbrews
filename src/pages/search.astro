---
import config from "config";
import Search from "../components/Search.astro";
import Base from "../layouts/Base.astro";

const title = "Search " + config.get("title");
---

<Base title={title} description={title}>
  <span data-pagefind-ignore>
    <article>
      <h1>{title}</h1>

      <Search />

      <p>
        Search for anything! Beer, coffee, tea, episodes, topics, the meaning of
        life... literally ANYTHING!
      </p>
    </article>
  </span>
</Base>
<style>
  p {
    text-align: center;
    max-width: 50ch;
    margin: 0 auto;
    padding: 3rem 0;
  }
</style>
