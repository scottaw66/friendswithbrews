---
import Search from "../components/Search.astro";
import Base from "../layouts/Base.astro";
import site from "../data/site.json";

const title = "Search " + site.title;
---

<Base title={title} description={title}>
  <span data-pagefind-ignore>
    <article>
      <h1>{title}</h1>

      <Search />

      <p>
        Search for anything! Beer, coffee, tea, episodes, topics, the meaning of
        life... literally ANYTHING!
      </p>
    </article>
  </span>
</Base>
<script>
  const input = document.querySelector("#search input");
  if (input instanceof HTMLInputElement) {
    input.focus();
  } else {
    const observer = new MutationObserver(() => {
      const input = document.querySelector("#search input");
      if (input instanceof HTMLInputElement) {
        input.focus();
        observer.disconnect();
      }
    });
    observer.observe(document.getElementById("search")!, { childList: true, subtree: true });
  }
</script>
<style>
  p {
    text-align: center;
    max-width: 50ch;
    margin: 0 auto;
    padding: 3rem 0;
  }
</style>
