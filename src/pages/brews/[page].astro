---
import config from "config";
import { brewList } from "../../components/utilities/brewlist.mjs";
import Base from "../../layouts/Base.astro";
import BrewDetails from "../../components/BrewDetails.astro";
import Pager from "../../components/Pager.astro";

export async function getStaticPaths({ paginate }) {
  const beers = brewList();

  return paginate(beers, {
    pageSize: config.get("beerPageSize"),
  });
}
const { page } = Astro.props;
const title = "The Brews";
---

<Base title={title}>
  <div data-pagefind-ignore>
    <h1>{title}!</h1>

    <link href="/styles/pagefind-ui.css" rel="stylesheet" />
    <script is:inline src="/_pagefind/pagefind-ui.js" type="text/javascript"
    ></script>

    <div id="search"></div>
    <script is:inline>
      window.addEventListener("DOMContentLoaded", (event) => {
        new PagefindUI({
          element: "#search",
          showImages: false,
          showEmptyFilters: false,
          translations: {
            placeholder: "Search Friends with Brews",
          },
        });
      });
    </script>

    <Pager page={page} />
    <div class="brew-container">
      {page.data.map((brew) => <BrewDetails brew={brew} />)}
    </div>
    <Pager page={page} />
  </div>
</Base>
