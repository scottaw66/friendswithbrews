---
import { Icon } from "astro-icon";
import { Picture } from "astro:assets";
import { hostname, origin } from "../../components/utilities/urlparser.mjs";
import {
  capitalize,
  brewIcon,
} from "../../components/utilities/stringformatter.mjs";
import Base from "../../layouts/Base.astro";
import brews from "../../data/brews.json";

export async function getStaticPaths() {
  return brews.map((bottle) => ({
    params: {
      brews: bottle.id,
    },
    props: {
      bottle,
    },
  }));
}

const { bottle } = Astro.props;
//const brewImage = bottle.image.replace(/(-)(\w{8}-\w{4}-\w{4}-\w{4}-\w{12})$/, "-1000$1$2") + ".webp";
---

<Base title={bottle.name}>
  <div class="brew-details" data-pagefind-meta=`result type: ${bottle.type}`>
    <h3>{bottle.brewery}</h3>
    <h2>{bottle.name}</h2>
    <div class="bottle">
      <a href={`/images/brews/${bottle.image}.png`}>
        <Picture src={import(`../../assets/images/brews/${bottle.image}.png`)} 
          formats={['avif', 'webp', 'jpg']} 
          width="1000"
          widths={[1500, 2000]}
          alt={`${bottle.brewery} ${bottle.name}`} />
      </a>
    </div>
    <div class="description">
      <p>{bottle.brewery} says:</p>
      <p>{bottle.description}</p>
    </div>
    <div class="ratings">
      {
        bottle.rating.map((rate) => (
          <>
            <div class="host">
              <div>{rate.host} says:</div>
              <div>
                THUMBS
                {rate.vote === "thumbs-up" ? "UP" : "DOWN"}!
              </div>
              <div>
                {rate.vote === "thumbs-up" ? (
                  <Icon name="bi:hand-thumbs-up-fill" />
                ) : (
                  <Icon name="bi:hand-thumbs-down-fill" />
                )}
              </div>
            </div>
            <div class="review">
              <p>{rate.description}</p>
            </div>
          </>
        ))
      }
    </div>
    <div class="type-links-container">
      <div class="links">
        <h4>Brew Type</h4>
        <div class="brew-type">
          <Icon name={brewIcon(bottle.type)} />
          <span data-pagefind-filter="filter by[content]" content={bottle.type}
            >{capitalize(bottle.type)}</span
          >
        </div>
      </div>
      <div class="links">
        <h4>Episode{bottle.episodes.length > 1 ? "s " : " "}</h4>
        { bottle.episodes.map((ep, index, arr) => (
            <span key={ep}>
              <a href={`/${ep}/`}>{ep}</a>{index !== arr.length - 1 ? ", " : ""}
            </span>
        ))}
      </div>
      <div class="links">
        <h4>Link</h4>
        <a href={bottle.url}>{bottle.name}</a> on <a href={origin(bottle.url)}
          >{hostname(bottle.url)}</a
        >
      </div>
    </div>
  </div>
</Base>
<style>
  h2,
  h3 {
    margin: 0;
  }
  h2 {
    color: var(--link-text);
  }
  div.brew-details {
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    justify-content: center;
    align-items: flex-start;
    max-width: 600px;
    margin: 1.5rem auto 0;
  }
  div.bottle {
    display: flex;
    margin: 0 auto;
    align-items: center;
    justify-content: center;
  }
  div.bottle img {
    border-radius: 10px;
    border: 5px solid var(--link-text);
    margin: 3rem auto 2rem;
    height: 22em;
    width: 22em;
  }
  div.description {
    font-size: 0.8em;
    margin-bottom: 2rem;
  }
  div.description p {
    margin: 0.75rem 0;
  }
  div.description p:nth-child(1) {
    font-weight: bold;
  }
  div.description p:nth-child(2) {
    font-style: italic;
  }
  div.description p:nth-child(2)::before,
  div.description p:nth-child(2)::after {
    content: '"';
  }
  div.ratings {
    margin: 0 auto 1rem;
    padding: 1rem 1rem 0.5rem;
    width: 450px;
    border: 1px solid var(--link-text);
    border-radius: 10px;
  }
  div.host {
    display: flex;
    justify-content: center;
    align-items: center;
    column-gap: 2rem;
    font-weight: bold;
    margin: 0 auto;
  }
  span.thumbs {
    margin: 0 2rem;
  }
  div.review {
    font-size: 0.9em;
    font-style: italic;
  }
  div.review p::before,
  div.review p::after {
    content: '"';
  }
  [astro-icon] {
    width: 2rem;
    margin: 0 0 -0.3rem;
  }
  [astro-icon="bi:hand-thumbs-up-fill"] {
    color: green;
  }
  [astro-icon="bi:hand-thumbs-down-fill"] {
    color: red;
  }
  div.type-links-container {
    display: flex;
    flex-direction: column;
    row-gap: 0.5rem;
  }
  div.brew-type [astro-icon] {
    width: 1.2rem;
    margin: 0 0.2rem -0.2em 0;
  }
  div.links {
    font-size: 1rem;
  }
  div.links h4 {
    margin-bottom: 0.75rem;
  }
  div.links a {
    color: var(--link-text);
  }
  @media screen and (max-width: 580px) {
    div.bottle img {
      height: 18em;
      width: 18em;
    }
    div.ratings {
      max-width: 350px;
    }
    div.host {
      column-gap: 1rem;
    }
    [astro-icon] {
      width: 1.1rem;
      margin: 0 0 -0.1rem;
    }
  }
  @media screen and (max-width: 450px) {
    div.ratings {
      max-width: 250px;
    }
    div.host {
      column-gap: 0.4rem;
      font-size: 0.75em;
    }
    [astro-icon] {
      width: 1.1rem;
      margin: 0 0 -0.1rem;
    }
  }
  @media screen and (max-width: 350px) {
    div.bottle img {
      height: 15em;
      width: 15em;
    }
  }
</style>
