---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";

const title = "Explore " + site.title;
const description =
  "Semantic search for Friends with Brews — find episodes, transcripts, brews, and shorts by meaning, not just keywords.";
---

{/* noindex: soft launch — no nav link yet, keep crawlers away until then */}
<Base title={title} description={description} noindex>
  <span data-pagefind-ignore>
    <article>
      <h1>{title}</h1>

      <form id="explore-form" role="search">
        <input
          id="explore-input"
          type="search"
          name="q"
          placeholder="What are you looking for?"
          autocomplete="off"
          maxlength="500"
          required
        />
        <button type="submit">Explore</button>
      </form>

      <div id="explore-filters" role="group" aria-label="Filter by type">
        <button type="button" class="chip" data-type="" aria-pressed="true"
          >All</button
        >
        <button type="button" class="chip" data-type="episode" aria-pressed="false"
          >Episodes</button
        >
        <button
          type="button"
          class="chip"
          data-type="transcript"
          aria-pressed="false">Transcripts</button
        >
        <button type="button" class="chip" data-type="brew" aria-pressed="false"
          >Brews</button
        >
        <button type="button" class="chip" data-type="short" aria-pressed="false"
          >Shorts</button
        >
      </div>

      <p id="explore-status" class="intro">
        Search by meaning — ask about a topic, a taste, a moment. Results come
        from every episode, transcript, brew, and YouTube short.
      </p>

      <ol id="explore-results"></ol>

      {/* Host-only corner: the search service gates these to Scott's and
          Peter's home IPs (or key); everyone else gets a friendly 403. */}
      <p id="explore-hosts">
        <a href="/api/guide">Hosts: agent access guides</a>
      </p>
    </article>
  </span>
</Base>

<script>
  const form = document.getElementById("explore-form") as HTMLFormElement;
  const input = document.getElementById("explore-input") as HTMLInputElement;
  const status = document.getElementById("explore-status") as HTMLElement;
  const list = document.getElementById("explore-results") as HTMLOListElement;
  const chips = [
    ...document.querySelectorAll<HTMLButtonElement>("#explore-filters .chip"),
  ];

  let type = "";
  let searching = false;

  const TYPE_LABELS: Record<string, string> = {
    transcript: "Transcript",
    episode: "Episode",
    brew: "Brew",
    short: "Short",
  };

  // Over-deliver: we ask for a deep result list and show ALL of it, but kNN
  // ranks by distance with no floor — the tail is "closest leftovers". So
  // results more than 10% farther than the best hit start tucked away behind
  // a "less relevant results" toggle instead of being cut off.
  // (Relative cutoff only — short queries compress all scores, so an absolute
  // floor would tuck entire filtered lists.)
  // score = 1/(1+distance), so distance = 1/score-1.
  const RELATIVE_CUTOFF = 1.1;

  // Passages shown per result before the "N more matching passages" expander.
  const VISIBLE_PASSAGES = 3;

  // Deep-link a passage with a URL text fragment (#:~:text=…): Safari and
  // Chrome scroll to AND highlight the quoted text — no site-side anchors
  // needed. Match on a short prefix (fragments can't cross block boundaries,
  // and long quotes with punctuation mismatch too easily); strip the leading
  // "Speaker:" label since it may sit in its own element on old-era pages.
  function passageHref(baseHref: string, r: any, snippet: string) {
    if (r.type === "short") return null; // YouTube pages: no text fragments
    const words = snippet
      .replace(/^[A-Za-z]+:\s*/, "")
      .replace(/…$/, "")
      .split(/\s+/)
      .slice(0, 8)
      .join(" ");
    if (!words) return null;
    return `${baseHref}#:~:text=${encodeURIComponent(words)}`;
  }

  // Shorts carry their YouTube publish date as "YYYY-MM-DD"; render it in the
  // site's episode-date style ("12 Jul 2026"). UTC keeps the calendar date
  // from shifting in western timezones.
  function fmtDate(iso: string) {
    const d = new Date(`${iso}T00:00:00Z`);
    return Number.isNaN(d.valueOf())
      ? iso
      : d.toLocaleDateString("en-GB", {
          day: "2-digit",
          month: "short",
          year: "numeric",
          timeZone: "UTC",
        });
  }

  function buildResult(r: any) {
      const li = document.createElement("li");
      li.className = "result";
      li.title = `match score ${r.score}`;

      const title = document.createElement("a");
      title.className = "result-title";
      // The API returns absolute site URLs (external consumers need them);
      // make them origin-relative so localhost testing stays on localhost.
      title.href = r.url.replace(/^https?:\/\/(www\.)?friendswithbrews\.com/, "") || "/";
      if (r.type === "short") {
        // Shorts have no page on the site — badge them and open YouTube.
        title.target = "_blank";
        title.rel = "noopener";
        const badge = document.createElement("span");
        badge.className = "badge";
        badge.textContent = "▶ Short";
        title.append(badge, " ");
      }
      title.append(r.title);

      const meta = document.createElement("div");
      meta.className = "result-meta";
      const bits = [];
      if (r.type === "short") {
        // section says which side of the capture matched: the YouTube
        // description ("notes") or what was actually said ("transcript")
        if (r.section === "notes") bits.push("Show notes");
        else if (r.section === "transcript") bits.push("Transcript");
      } else {
        bits.push(TYPE_LABELS[r.type] ?? r.type);
      }
      if (r.episode != null) bits.push(`Episode ${r.episode}`);
      if (r.published) bits.push(fmtDate(r.published));
      if (r.matches) bits.push(`${r.matches} matching passages`);
      if (r.type === "short") bits.push("watch on YouTube");
      meta.textContent = bits.join(" · ");

      // Surface the matching passages themselves (not just "29 matching
      // passages"): each one links straight to the highlighted spot in the
      // source. The API returns EVERY matching passage; show the top few and
      // tuck the rest behind a per-result expander so a 29-match transcript
      // stays skimmable but nothing is out of reach. Fall back to the lone
      // snippet if the API predates `passages`.
      const passages = r.passages ?? [
        { snippet: r.snippet, ...(r.timestamp ? { timestamp: r.timestamp } : {}) },
      ];
      li.append(title, meta);
      passages.forEach((p, i) => {
        const href = passageHref(title.getAttribute("href") ?? "", r, p.snippet);
        const el = document.createElement(href ? "a" : "p");
        el.className = "result-snippet";
        if (i >= VISIBLE_PASSAGES) el.classList.add("passage-tucked");
        if (href) (el as HTMLAnchorElement).href = href;
        if (p.timestamp) {
          const time = document.createElement("span");
          time.className = "passage-time";
          time.textContent = p.timestamp;
          el.append(time, " ");
        }
        el.append(p.snippet);
        li.append(el);
      });
      const hidden = passages.length - VISIBLE_PASSAGES;
      if (hidden > 0) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "result-more";
        btn.setAttribute("aria-expanded", "false");
        const label = `${hidden} more matching passage${hidden === 1 ? "" : "s"}`;
        btn.textContent = label;
        btn.addEventListener("click", () => {
          const open = li.classList.toggle("show-passages");
          btn.setAttribute("aria-expanded", String(open));
          btn.textContent = open ? "show fewer passages" : label;
        });
        li.append(btn);
      }
      return li;
  }

  function render(results: any[]) {
    list.replaceChildren();
    list.classList.remove("show-tucked");
    const topDist = results.length ? 1 / results[0].score - 1 : 0;
    // Results arrive distance-sorted, so the tuck point is a single index.
    const tuckAt = results.findIndex(
      (r) => 1 / r.score - 1 > topDist * RELATIVE_CUTOFF,
    );
    results.forEach((r, i) => {
      const li = buildResult(r);
      if (tuckAt !== -1 && i >= tuckAt) li.classList.add("tucked");
      list.append(li);
    });
    if (tuckAt !== -1) {
      const n = results.length - tuckAt;
      const toggle = document.createElement("li");
      toggle.className = "result-toggle";
      const btn = document.createElement("button");
      btn.type = "button";
      btn.setAttribute("aria-expanded", "false");
      btn.textContent = `${n} less relevant result${n === 1 ? "" : "s"}`;
      btn.addEventListener("click", () => {
        const open = list.classList.toggle("show-tucked");
        btn.setAttribute("aria-expanded", String(open));
      });
      toggle.append(btn);
      list.insertBefore(toggle, list.children[tuckAt]);
    }
  }

  async function search(query: string) {
    if (searching) return;
    searching = true;
    status.textContent = "Searching…";
    status.className = "";
    try {
      const res = await fetch("/api/search", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query, k: 50, ...(type ? { type } : {}) }),
      });
      if (res.status === 429) {
        status.textContent = "Whoa, easy there — give it a second and try again.";
        return;
      }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const { results } = await res.json();
      render(results);
      status.textContent = results.length
        ? ""
        : "Nothing brewed up for that one. Try different words?";
      const params = new URLSearchParams({ q: query });
      if (type) params.set("type", type);
      history.replaceState(null, "", `?${params}`);
    } catch {
      status.textContent =
        "Search is having a moment. Try again in a bit.";
    } finally {
      searching = false;
    }
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (q) search(q);
  });

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      type = chip.dataset.type ?? "";
      for (const c of chips)
        c.setAttribute("aria-pressed", String(c === chip));
      const q = input.value.trim();
      if (q) search(q);
    });
  }

  // Shareable links: /explore?q=…&type=…
  const params = new URLSearchParams(location.search);
  const q = params.get("q")?.trim();
  const t = params.get("type") ?? "";
  const preset = chips.find((c) => c.dataset.type === t);
  if (preset && t) preset.click();
  if (q) {
    input.value = q;
    if (!(preset && t)) search(q); // preset.click() already searched
  }
  input.focus();
</script>

<style>
  h1 {
    text-align: center;
  }
  #explore-form {
    display: flex;
    gap: 0.75rem;
    max-width: 44rem;
    margin: 1rem auto 0;
  }
  #explore-input {
    flex: 1;
    height: 3.25rem;
    font-size: 1.5rem;
    padding: 0 1rem;
    color: var(--text);
    background-color: var(--surface);
    border: 2px solid var(--menu-surface);
    border-radius: 8px;
  }
  #explore-input:focus {
    outline: 2px solid var(--menu-surface);
    outline-offset: 1px;
  }
  #explore-form button {
    height: 3.25rem;
    padding: 0 1.5rem;
    font-family: "CaptainEdward";
    font-size: 1.4rem;
    color: var(--pager-link-text);
    background-color: var(--pager-bg);
    border: none;
    border-radius: 8px;
    cursor: pointer;
  }
  #explore-form button:hover {
    color: var(--header-surface);
  }
  #explore-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 1rem auto;
  }
  .chip {
    font-size: 1rem;
    padding: 0.35rem 0.9rem;
    color: var(--text);
    background-color: var(--surface);
    border: 2px solid var(--menu-surface);
    border-radius: 999px;
    cursor: pointer;
  }
  .chip[aria-pressed="true"] {
    background-color: var(--pager-bg);
    color: var(--pager-link-text);
    border-color: var(--pager-bg);
  }
  #explore-status {
    text-align: center;
    max-width: 50ch;
    margin: 0 auto;
    padding: 1.5rem 0;
  }
  #explore-results {
    list-style: none;
    max-width: 44rem;
    margin: 0 auto 3rem;
    padding: 0;
  }
  #explore-hosts {
    text-align: center;
    font-size: 0.85rem;
    margin: 0 auto 2rem;
  }
  #explore-hosts a {
    color: var(--link-text);
  }
  @media only screen and (max-width: 899px) {
    #explore-form {
      flex-direction: column;
    }
  }
</style>

<!-- Result cards are created by the client script, so Astro's scoped styles
     never match them — these rules must be global (namespaced by the id). -->
<style is:global>
  #explore-results .result {
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
    background-color: var(--surface);
    border: 2px solid var(--menu-surface);
    border-radius: 8px;
  }
  #explore-results .result-title {
    font-size: 1.4rem;
    color: var(--episode-title);
    text-decoration: none;
  }
  #explore-results .result-title:hover {
    text-decoration: underline;
  }
  #explore-results .badge {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: bold;
    vertical-align: middle;
    padding: 0.1rem 0.6rem;
    margin-right: 0.25rem;
    color: var(--pager-link-text);
    background-color: var(--pager-bg);
    border-radius: 999px;
  }
  #explore-results .result-meta {
    font-size: 0.95rem;
    color: var(--link-text);
    margin: 0.25rem 0 0.5rem;
  }
  #explore-results .result-snippet {
    display: block;
    margin: 0 0 0.6rem;
    padding: 0.4rem 0.75rem;
    color: var(--episode-text);
    text-decoration: none;
    border-left: 3px solid var(--menu-surface);
  }
  #explore-results .result-snippet:last-child {
    margin-bottom: 0;
  }
  #explore-results a.result-snippet:hover {
    border-left-color: var(--pager-bg);
    background-color: color-mix(in srgb, var(--pager-bg) 8%, transparent);
  }
  #explore-results .passage-time {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: bold;
    padding: 0 0.5rem;
    color: var(--pager-link-text);
    background-color: var(--pager-bg);
    border-radius: 999px;
  }
  #explore-results .result .passage-tucked {
    display: none;
  }
  #explore-results .result.show-passages .passage-tucked {
    display: block;
  }
  #explore-results .result-more {
    display: block;
    margin: 0;
    padding: 0.25rem 0.75rem;
    font-family: "CaptainEdward";
    font-size: 1rem;
    letter-spacing: 0.05em;
    color: var(--link-text);
    background: none;
    border: none;
    cursor: pointer;
  }
  #explore-results .result-more::before {
    content: "▸ ";
  }
  #explore-results .result-more[aria-expanded="true"]::before {
    content: "▾ ";
  }
  #explore-results .result-more:hover {
    color: var(--episode-title);
  }
  #explore-results .result.tucked {
    display: none;
  }
  #explore-results.show-tucked .result.tucked {
    display: block;
  }
  #explore-results .result-toggle {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0 1rem;
  }
  #explore-results .result-toggle::before,
  #explore-results .result-toggle::after {
    content: "";
    flex: 1;
    border-top: 2px solid var(--menu-surface);
  }
  #explore-results .result-toggle button {
    font-family: "CaptainEdward";
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    color: var(--link-text);
    background: none;
    border: none;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
  }
  #explore-results .result-toggle button::before {
    content: "▸ ";
  }
  #explore-results .result-toggle button[aria-expanded="true"]::before {
    content: "▾ ";
  }
  #explore-results .result-toggle button:hover {
    color: var(--episode-title);
  }
</style>
