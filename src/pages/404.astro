---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Search from "../components/Search.astro";
import site from "../data/site.json";

import emptyBottleImage from "../assets/images/404/404-empty-bottle.jpg";

let title = "404 not found";
---

<Base title={title + " - " + site.title}>
  <span data-pagefind-ignore>
    <article>
      <h1>{title}</h1>

      <Search />

      <p>Sorry, the bottle you're looking for is empty or missing!</p>

      <div class="missing-image">
        <Image src={emptyBottleImage} width={300} alt={title} />
      </div>

      <p>
        Please use the search box to find that perfect sip of information, or
        use one of the menu links at the top of the page to find the perfect <a
          href="/episodes/1">episode</a
        > or <a href="brews/1">brew</a>.
      </p>
    </article>
  </span>
</Base>
<style>
  a {
    color: var(--menu-surface);
    font-weight: bolder;
  }
  div.missing-image {
    display: flex;
    margin: 3rem auto;
    justify-content: center;
  }
  div.missing-image img {
    border-radius: 50%;
    border: solid 3px var(--menu-surface);
  }
</style>
