---
import config from "config";
import { Picture } from "@astrojs/image/components";
import Base from "../layouts/Base.astro";
import Search from "../components/Search.astro";

import emptyBottleImage from "../images/404/404-empty-bottle.jpg";

let title = "404 not found";
---

<Base title={title + " - " + config.get("title")}>
  <span data-pagefind-ignore>
    <article>
      <h1>{title}</h1>

      <Search />

      <p>Sorry, the bottle you're looking for is empty or missing!</p>

      <div class="missing-image">
        <Picture
          src={emptyBottleImage}
          widths={[600, 900, 1800]}
          aspectRatio="1:1"
          sizes="300px"
          formats={["avif", "webp"]}
          alt={title}
        />
      </div>

      <p>
        Please use the search box to find that perfect sip of information, or
        use one of the menu links at the top of the page to find the perfect <a
          href="/episodes/1">episode</a
        > or <a href="brews/1">brew</a>.
      </p>
    </article>
  </span>
</Base>
<style>
  :root {
    --pagefind-ui-primary: var(--menu-surface);
    --pagefind-ui-text: #000;
    --pagefind-ui-background: #83645a;
    --pagefind-ui-border: var(--menu-border);
    --pagefind-ui-tag: #b59c94;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --pagefind-ui-primary: var(--menu-surface);
      --pagefind-ui-text: #fff;
      --pagefind-ui-background: var(--menu-border);
      --pagefind-ui-border: var(--menu-border);
      --pagefind-ui-tag: #0d0a01;
    }
  }

  a {
    color: var(--menu-surface);
    font-weight: bolder;
  }
  div.missing-image {
    display: flex;
    margin: 3rem auto;
    justify-content: center;
  }
  div.missing-image img {
    border-radius: 50%;
    border: solid 3px var(--menu-surface);
  }
</style>
