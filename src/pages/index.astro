---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import site from "../data/site.json";
import Base from "../layouts/Base.astro";
import EpisodeDetails from "../components/EpisodeDetails.astro";
import Reviews from "../components/Reviews.astro";

const title = site.title;

let allEpisodes = await getCollection("episodes");
allEpisodes = allEpisodes.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);

const latestEpisodes = allEpisodes.slice(0, 1);
---

<Base title={title}>
  <article>
    <div class="download-link">
      <div>
        <a href={site.social.youtube}>
          <Icon name="simple-icons:youtube" />
        </a>
      </div>
      <div>
        <a href={site.social.youtube}> Watch on YouTube </a>
      </div>
    </div>
    <p>
      <b>Friends with Brews Podcast</b> is about friends Peter and Scott, beer, coffee,
      tea, and podcasting! It's also about Apple, fitness, food, random news, and
      sometimes our friend Adam!
    </p>
    <span data-pagefind-ignore>
      <h2 class="latest"><Icon name="fa:certificate" />Latest Episode !!</h2>

      {
        latestEpisodes &&
          latestEpisodes.map((latest) => {
            return <EpisodeDetails episode={latest} />;
          })
      }
    </span>
    <h2 class="edward"><Icon name="dashicons:awards" />Reviews</h2>
    <p>
      We've gotten some amazing reviews. Check these out!<Icon
        name="bi:arrow-down-circle-fill"
      />
    </p>
    <Reviews />
  </article>
</Base>

<style>
  div.download-link {
    display: flex;
    padding: 0;
    font-size: 1.5rem;
    text-transform: uppercase;
    font-weight: bold;
    align-items: center;
  }
  div.download-link a {
    color: var(--text);
    text-decoration: underline;
  }
  [data-icon] {
    font-size: 3rem;
    margin: 0.6rem 1rem 0 -0.1rem;
  }

  [data-icon="fa:certificate"] {
    font-size: 0.9em;
    margin: 0 0.5em -0.1rem 0;
    color: var(--text);
  }

  [data-icon="bi:arrow-down-circle-fill"] {
    font-size: 0.9em;
    margin: 0 0.5em -0.1rem 0.5em;
    color: var(--text);
  }

  [data-icon="dashicons:awards"] {
    font-size: 1em;
    margin: 0 0.2em -0.1em -0.1em;
    padding: 0;
    color: var(--text);
  }

  h2.latest {
    font-family: "Be Vietnam Pro";
    font-size: 1.2em;
    font-style: italic;
    color: var(--text);
  }

  h2 {
    margin-top: 3rem;
  }
</style>
