---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";

const title = "The Friends";

import scott from "../assets/images/hosts/sawb.jpg";
import peter from "../assets/images/hosts/peter.jpg";
---

<Base title={title}>
  <h1>The Friends!</h1>
  <div class="hosts">
    <div class="host">
      <div class="host-image">
        <Image src={peter} width={200} height={200} alt="Peter Nikolaidis" />
      </div>
      <div class="host-details">
        <h2>Peter Nikolaidis</h2>
        <p>
          Peter Nikolaidis discovered his passion for computers and information
          technology at a young age. An IT and security professional, Peter
          practices yoga, martial arts, running, biking, as well as
          self-improvement and mindfulness.
        </p>
        <div class="host-socials">
          <div class="social">
            <div>
              <Icon name="simple-icons:bluesky" />
            </div>
            <div>
              <a href="https://bsky.app/profile/peternikolaidis.com"
                >@peternikolaidis.com</a
              >
            </div>
          </div>
          <div class="social">
            <div>
              <Icon name="simple-icons:mastodon" />
            </div>
            <div>
              <a rel="me" href="https://infosec.exchange/@nikolaidis"
                >@nikolaidis@infosec.exchange</a
              >
            </div>
          </div>
          <div class="social">
            <div>
              <Icon name="fontisto:safari" />
            </div>
            <div>
              <a rel="me" href="https://pn72.com/">pn72.com</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="host">
      <div class="host-image">
        <Image src={scott} width={200} height={200} alt="Scott Willsey" />
      </div>
      <div class="host-details">
        <h2>Scott Willsey</h2>
        <p>
          Scott is an old school semiconductor guy, painfully infrequent writer,
          and off and on podcaster. Scott loves playing with computers, biking,
          running, yoga, and cats. Most of all, Scott loves his amazing family.
        </p>
        <div class="host-socials">
          <div class="social">
            <div>
              <Icon name="simple-icons:bluesky" />
            </div>
            <div>
              <a href="https://bsky.app/profile/scottwillsey.com"
                >@scottwillsey.com</a
              >
            </div>
          </div>
          <div class="social">
            <div>
              <Icon name="simple-icons:mastodon" />
            </div>
            <div>
              <a href="https://social.lol/@scottwillsey"
                >@scottwillsey@social.lol</a
              >
            </div>
          </div>
          <div class="social">
            <div>
              <Icon name="fontisto:safari" />
            </div>
            <div>
              <a href="https://scottwillsey.com">scottwillsey.com</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  div.hosts {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    row-gap: 5rem;
    justify-items: stretch;
    margin: 3rem auto;
    padding: 1rem;
  }
  div.host {
    display: grid;
    grid-template-columns: 1fr 4fr;
    column-gap: 3rem;
    align-items: center;
  }
  div.host h2 {
    margin-bottom: 1rem;
  }
  div.host-image img {
    border-radius: 50%;
    border: solid 3px var(--menu-border);
  }
  @media screen and (max-width: 650px) {
    div.host-image img {
      width: 150px;
    }
  }
  div.host-socials {
    display: flex;
    column-gap: 2rem;
    row-gap: 1rem;
    flex-wrap: wrap;
  }
  div.host-socials a,
  div.links a {
    color: var(--link-text);
    font-weight: bolder;
  }
  div.social,
  div.links {
    display: flex;
    align-items: center;
    column-gap: 0.5rem;
    max-width: fit-content;
  }
  div.links {
    margin: 4rem auto 2rem;
    justify-content: center;
  }
  div.links [data-icon] {
    font-size: 2rem;
  }
  [data-icon] {
    font-size: 1.5rem;
    margin: 0 0 -0.4rem;
  }
  @media screen and (max-width: 650px) {
    div.host {
      grid-template-columns: 1fr;
      padding: 0;
    }
    div.host-image {
      display: flex;
      justify-content: center;
      margin: 0;
      padding: 0;
    }
    div.social {
      flex-wrap: wrap;
      font-size: 0.9em;
    }
  }
</style>
